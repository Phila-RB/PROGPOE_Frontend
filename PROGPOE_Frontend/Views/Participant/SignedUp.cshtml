@model IEnumerable<PROGPOE_Frontend.Models.SignedUpResponse>

<style>
    body {
        background-color: #f4f6f3;
    }

    .events-wrapper {
        min-height: 100vh;
        padding: 50px 0;
    }

    .sport-label {
        color: #85ad42;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 3px;
    }

    .events-heading {
        font-weight: 900;
        font-size: 2.8rem;
        color: #172b22;
        letter-spacing: -1.5px;
    }

    .events-heading span {
        color: #8dbd42;
    }

    .events-subtitle {
        color: #7b877f;
    }

    .results-card {
        background: white;
        border: 1px solid #e7ece5;
        border-radius: 10px;
        overflow: hidden;
    }

    .results-table {
        margin-bottom: 0;
        vertical-align: middle;
    }

    .results-table thead {
        background: #172b22;
        color: white;
    }

    .results-table thead th {
        padding: 18px 20px;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        border: none;
    }

    .results-table tbody td {
        padding: 20px;
        color: #263b2d;
        font-size: 14px;
        font-weight: 500;
        border-color: #edf0eb;
    }

    .results-table tbody tr {
        transition: .2s ease;
    }

    .results-table tbody tr:hover {
        background-color: #f3f8ed;
    }

    .results-table tbody tr:last-child td {
        border-bottom: none;
    }

    .event-name {
        font-weight: 800 !important;
        color: #172b22 !important;
    }

    .section-title {
        color: #263b2d;
        font-weight: 800;
    }

    @@media (max-width: 768px) {
        .results-table thead th,
        .results-table tbody td {
            padding: 14px 12px;
        }
    }
</style>

<div class="events-wrapper">
    <div class="container">

        <!-- HEADER -->
        <div class="mb-5">

            <div class="sport-label mb-2">
                YOUR JOURNEY • YOUR COMMITMENT
            </div>

            <h1 class="events-heading">
                Events <span>Joined.</span>
            </h1>

            <p class="events-subtitle">
                Keep track of the competitions you've signed up for.
            </p>

        </div>

        <!-- EVENTS TABLE -->
        <div class="mb-3">
            <h5 class="section-title mb-0">
                My Registered Events
            </h5>
        </div>

        <div class="results-card shadow-sm">

            <div class="table-responsive">

                <table class="table results-table">

                    <thead>
                        <tr>
                            <th>Event</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var res in Model)
                        {
                            <tr>
                                <td class="event-name">
                                    @res.EventName
                                </td>

                                <td>
                                    @res.Status
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>

            </div>

        </div>

    </div>
</div>
