@model IEnumerable<PROGPOE_Frontend.Models.Category>

<style>
    body {
        background-color: #f4f6f3;
    }

    .events-wrapper {
        min-height: 100vh;
        padding: 50px 0;
    }

    .sport-label {
        color: #85ad42;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 3px;
    }

    .events-heading {
        font-weight: 900;
        font-size: 2.8rem;
        color: #172b22;
        letter-spacing: -1.5px;
    }

    .events-heading span {
        color: #8dbd42;
    }

    .events-subtitle {
        color: #7b877f;
    }

    .category-card {
        background: white;
        border: 1px solid #e7ece5;
        border-radius: 10px;
        height: 100%;
        transition: .25s ease;
    }

    .category-card:hover {
        transform: translateY(-5px);
        border-color: #9bc65b;
        box-shadow: 0 12px 25px rgba(0,0,0,.08);
    }

    .category-number {
        color: #91b75c;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 2px;
    }

    .category-title {
        font-size: 19px;
        font-weight: 800;
        color: #1c3024;
        min-height: 48px;
    }

    .btn-join {
        background: #8dbd42;
        color: #172b22;
        border: none;
        border-radius: 5px;
        padding: 12px;
        font-size: 12px;
        font-weight: 900;
        letter-spacing: 1px;
        transition: .2s;
    }

    .btn-join:hover {
        background: #172b22;
        color: #b6e878;
    }

    .category-count {
        color: #89948b;
        font-size: 12px;
        font-weight: 700;
    }
</style>

<div class="events-wrapper">
    <div class="container">

        <div class="mb-5">
            <div class="sport-label mb-2">
                TAKE YOUR PLACE • JOIN THE ACTION
            </div>

            <h1 class="events-heading">
                Choose Your <span>Category.</span>
            </h1>

            <p class="events-subtitle">
                Select a category to join the competition.
            </p>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0" style="color:#263b2d;">
                Available Categories
            </h5>

            <span class="category-count">
                CATEGORIES
            </span>
        </div>

        <div class="row g-4">
            @{
                int index = 1;
            }

            @foreach (var cat in Model)
            {
                <div class="col-sm-6 col-lg-4 col-xl-3">

                    <div class="card category-card shadow-sm">
                        <div class="card-body p-4">

                            <div class="category-number mb-4">
                                CATEGORY / @index.ToString("00")
                            </div>

                            <h5 class="category-title mb-4">
                                @cat.CategoryName
                            </h5>

                            <Form asp-action="Signup" method="post">
                                @Html.AntiForgeryToken()

                                <input type="hidden" name="CategoryID" value="@cat.CategoryID" />
                                <input type="hidden" name="EventID" value="@cat.EventID" />

                                <button type="submit" class="btn btn-join w-100">
                                    Join
                                </button>
                            </Form>

                        </div>
                    </div>

                </div>

                index++;
            }
        </div>

    </div>
</div>
