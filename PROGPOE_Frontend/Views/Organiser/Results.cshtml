@model PROGPOE_Frontend.Models.ParticipantResults
<div>
	<Form asp-action="CreateResults" method="post">
		<lable>Participant ID: </lable>
		<input id="participantID" asp-for="ParticipantID" required /> <br />
		<lable>Event ID: </lable>
		<input id="eventID" asp-for="EventID" required /> <br />
		<lable>Placement: </lable>
		<input id="placement" asp-for="Placement" required /> <br />
		<lable>Time: </lable>
		<input id="time" asp-for="Time" required /> <br />
		<button type="submit">Update</button>
	</Form>
</div>