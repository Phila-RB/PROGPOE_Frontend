@model PROGPOE_Frontend.Models.Event
<div>
	<Form asp-action="Update" method="post">
		<input type="hidden" id="EventID" asp-for="EventID" value="@Model.EventID"/> 
		<lable>Event Name</lable>
		<input id="name" asp-for="EventName"/> <br />
		<lable>Location</lable>
		<input id="location" asp-for="Location"/> <br />
		<lable>Description</lable>
		<input id="description" asp-for="Description"/> <br />
		<lable>Date</lable>
		<input id="date" asp-for="Date"/> <br />
		<lable>Type</lable>
		<input id="type" asp-for="Type"/> <br />
		<button type="submit">Update</button>
	</Form>
</div