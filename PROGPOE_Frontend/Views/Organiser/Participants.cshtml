@model IEnumerable<PROGPOE_Frontend.Models.Participant>

<div>
    <h2>Events Joined</h2>
    <table class="table">
        <thead>
            <tr>
                <th>Event</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var res in Model)
            {
                <tr>
                    <td>
                        @res.
                    </td>
                    <td>
                        @res.Status
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
