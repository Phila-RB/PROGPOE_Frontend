@model IEnumerable<PROGPOE_Frontend.Models.OrganiserEvents>

<style>
    body {
        background-color: #f4f6f3;
    }

    .events-wrapper {
        min-height: 100vh;
        padding: 50px 0;
    }

    .sport-label {
        color: #85ad42;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 3px;
    }

    .events-heading {
        font-weight: 900;
        font-size: 2.8rem;
        color: #172b22;
        letter-spacing: -1.5px;
    }

    .events-heading span {
        color: #8dbd42;
    }

    .events-subtitle {
        color: #7b877f;
    }

    .dashboard-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 40px;
    }

    .btn-dashboard {
        background: #172b22;
        color: #b6e878;
        border: none;
        border-radius: 5px;
        padding: 12px 20px;
        font-size: 11px;
        font-weight: 900;
        letter-spacing: 1px;
        text-decoration: none;
        transition: .2s;
    }

    .btn-dashboard:hover {
        background: #8dbd42;
        color: #172b22;
        transform: translateY(-2px);
    }

    .btn-dashboard-primary {
        background: #8dbd42;
        color: #172b22;
    }

    .btn-dashboard-primary:hover {
        background: #172b22;
        color: #b6e878;
    }

    .section-heading {
        color: #172b22;
        font-size: 21px;
        font-weight: 900;
        margin-bottom: 5px;
    }

    .section-subtitle {
        color: #89948b;
        font-size: 12px;
        margin-bottom: 20px;
    }

    .event-section {
        background: white;
        border: 1px solid #e7ece5;
        border-radius: 10px;
        overflow: hidden;
        height: 100%;
    }

    .section-header {
        background: #172b22;
        color: white;
        padding: 22px 25px;
        border-bottom: 4px solid #8dbd42;
    }

    .section-header h4 {
        font-size: 16px;
        font-weight: 900;
        margin-bottom: 5px;
    }

    .section-header p {
        color: #b6e878;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 2px;
        margin-bottom: 0;
    }

    .event-list {
        padding: 20px;
    }

    .event-card {
        background: #fafbf9;
        border: 1px solid #edf0eb;
        border-radius: 8px;
        padding: 20px;
        margin-bottom: 15px;
        transition: .2s;
    }

    .event-card:last-child {
        margin-bottom: 0;
    }

    .event-card:hover {
        border-color: #9bc65b;
        background: #f3f8ed;
        transform: translateY(-3px);
    }

    .event-id {
        color: #91b75c;
        font-size: 10px;
        font-weight: 900;
        letter-spacing: 2px;
        margin-bottom: 8px;
    }

    .event-name {
        color: #172b22;
        font-size: 17px;
        font-weight: 900;
        margin-bottom: 15px;
    }

    .event-info {
        color: #77847a;
        font-size: 13px;
        margin-bottom: 8px;
    }

    .event-info strong {
        color: #263b2d;
    }

    .btn-view {
        display: inline-block;
        background: #8dbd42;
        color: #172b22;
        border: none;
        border-radius: 5px;
        padding: 9px 22px;
        font-size: 11px;
        font-weight: 900;
        letter-spacing: 1px;
        margin-top: 10px;
        transition: .2s;
    }

    .btn-view:hover {
        background: #172b22;
        color: #b6e878;
    }

    .event-table {
        margin-bottom: 0;
    }
</style>

<div class="events-wrapper">
    <div class="container">

        <!-- HEADER -->
        <div class="mb-4">

            <div class="sport-label mb-2">
                ORGANISE • TRACK • ACHIEVE
            </div>

            <h1 class="events-heading">
                Organiser <span>Dashboard.</span>
            </h1>

            <p class="events-subtitle">
                Manage your events, participants and results.
            </p>

        </div>

        <!-- EXISTING NAVIGATION -->
        <div class="dashboard-actions">

            <a asp-action="CategoriesView"
               class="btn-dashboard">
                CATEGORIES
            </a>

            <a asp-action="Results"
               class="btn-dashboard">
                ADD RESULTS
            </a>

            <a asp-action="CreateEvent"
               class="btn-dashboard btn-dashboard-primary">
                CREATE EVENT
            </a>

            <a asp-action="CreateCategory"
               class="btn-dashboard">
                CREATE CATEGORY
            </a>

        </div>

        <div class="row g-4">

            <!-- UPCOMING EVENTS -->
            <div class="col-lg-6">

                <div class="event-section shadow-sm">

                    <div class="section-header">
                        <h4>Upcoming Events</h4>
                        <p>YOUR NEXT COMPETITIONS</p>
                    </div>

                    <div class="event-list">

                        <div class="section-subtitle">
                            Scheduled sporting events
                        </div>

                        <table class="table event-table">
                            <tbody>
                                @foreach (var eve in Model)
                                {
                                    @if (eve.Date >= DateTime.Now)
                                    {
                                        <tr>
                                            <td class="border-0 p-0 pb-3">

                                                <div class="event-card">

                                                    <form asp-action="EventView" method="get">

                                                        <input type="hidden"
                                                               name="EventID"
                                                               value="@eve.EventID" />

                                                        <div class="event-id">
                                                            EVENT ID: @eve.EventID
                                                        </div>

                                                        <h5 class="event-name">
                                                            @eve.EventName
                                                        </h5>

                                                        <p class="event-info">
                                                            <strong>Enrollments:</strong>
                                                            @eve.TotalEnrollments
                                                        </p>

                                                        <p class="event-info">
                                                            <strong>Date:</strong>
                                                            @eve.Date
                                                        </p>

                                                        <button type="submit" class="btn-view">
                                                            VIEW EVENT →
                                                        </button>

                                                    </form>

                                                </div>

                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>

                    </div>

                </div>

            </div>

            <!-- PAST EVENTS -->
            <div class="col-lg-6">

                <div class="event-section shadow-sm">

                    <div class="section-header">
                        <h4>Past Events</h4>
                        <p>PREVIOUS COMPETITIONS</p>
                    </div>

                    <div class="event-list">

                        <div class="section-subtitle">
                            Previously held sporting events
                        </div>

                        <table class="table event-table">
                            <tbody>
                                @foreach (var eve in Model)
                                {
                                    @if (eve.Date < DateTime.Now)
                                    {
                                        <tr>
                                            <td class="border-0 p-0 pb-3">

                                                <div class="event-card">

                                                    <form asp-action="EventView" method="get">

                                                        <input type="hidden"
                                                               name="EventID"
                                                               value="@eve.EventID" />

                                                        <h5 class="event-name">
                                                            @eve.EventName
                                                        </h5>

                                                        <p class="event-info">
                                                            <strong>Enrollments:</strong>
                                                            @eve.TotalEnrollments
                                                        </p>

                                                        <p class="event-info">
                                                            <strong>Date:</strong>
                                                            @eve.Date
                                                        </p>

                                                        <button type="submit" class="btn-view">
                                                            VIEW EVENT →
                                                        </button>

                                                    </form>

                                                </div>

                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>

                    </div>

                </div>

            </div>

        </div>

    </div>
</div>
